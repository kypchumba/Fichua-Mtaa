# Copy to .env for local development; the application imports it when started from backend/.
# Keep real values out of Git. Render should set these as environment variables.
PORT=8081
DATABASE_URL=jdbc:postgresql://localhost:5432/fichuamtaa
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-local-password
DB_POOL_SIZE=5
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_SAME_SITE=lax
ADMIN_EMAIL=
ADMIN_PASSWORD=
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_WINDOW=15m
REGISTRATION_RATE_LIMIT_MAX_ENTRIES=10000
# Leave blank unless the hosting proxy source CIDRs have been verified.
TRUSTED_PROXY_CIDRS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
